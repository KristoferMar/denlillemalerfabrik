

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;"
>
  <div class="announcement-bar__row">
    {% content_for 'blocks' %}
  </div>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
  }

  /* 3-up row: left / center / right */
  .announcement-bar__row {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    align-items: center;
    gap: 24px;
    width: 100%;
    max-width: 1400px;
    margin-inline: auto;
    padding-inline: 16px;
  }

  /* Override the block's transition + aria-hidden hiding (designed for the
     slider). In the static grid every slide stays visible. */
  .announcement-bar__slide {
    transition: none;
    place-content: center;
    /* Defeat the inline --line-height: 1 (the block hardcodes it) so g/p/y
       descenders aren't clipped. !important is needed to beat the inline
       style declaration. */
    --line-height: 1.6 !important;
  }
  .announcement-bar__slide[aria-hidden='true'] {
    opacity: 1;
    visibility: visible;
  }

  /* Direct override on the <p>, with !important to beat the framework's
     .custom-typography p { line-height: var(--line-height--body, ...) } rule. */
  .announcement-bar__slide .announcement-bar__text {
    line-height: 1.6 !important;
    margin: 0;
    padding-block-end: 2px;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }

  /* Mobile: 3 short strings side-by-side gets cramped fast. Show only the
     middle one; the left + right cells collapse. */
  @media screen and (max-width: 749px) {
    .announcement-bar__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .announcement-bar__row > :nth-child(1),
    .announcement-bar__row > :nth-child(3) {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.scroll_speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-4",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
