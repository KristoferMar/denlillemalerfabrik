{%- comment -%}
  The photo is a real <img> inside <picture>, not a CSS background, for two
  reasons:
    1. Art direction. The wide shot keeps its empty left half for the text;
       the mobile shot is a 2:3 crop with the tins at the bottom and the text
       area on top. One photo cannot be both, and <source media> lets the
       browser pick BEFORE layout — no user-agent sniffing, which gets iPads
       wrong and downloads both files.
    2. Speed. The hero is the LCP element. A background-image is only
       discovered once CSS is parsed; an <img> with fetchpriority="high" is
       fetched immediately.
{%- endcomment -%}
<div class="kmeconsulting-hero color-{{ section.settings.color_scheme }}">
  <picture class="kmeconsulting-hero__picture">
    <source
      media="(max-width: 749px)"
      srcset="{{ 'hero-image-mobile.jpg' | asset_url }}"
      width="1024"
      height="1536"
    >
    <img
      class="kmeconsulting-hero__img"
      src="{{ 'hero-image.jpg' | asset_url }}"
      width="2560"
      height="914"
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    >
  </picture>

  <div class="kmeconsulting-hero__inner">
    <div class="kmeconsulting-hero__content">
      {%- if section.settings.title != blank -%}
        <h2 class="kmeconsulting-hero__title">{{ section.settings.title }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="kmeconsulting-hero__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}

      <div class="kmeconsulting-hero__buttons">
        {%- if section.settings.button_label_1 != blank -%}
          <a
            href="{{ section.settings.button_link_1 }}"
            class="button"
          >
            {{ section.settings.button_label_1 }}
          </a>
        {%- endif -%}

        {%- if section.settings.button_label_2 != blank -%}
          <a
            href="{{ section.settings.button_link_2 }}"
            class="button-secondary"
          >
            {{ section.settings.button_label_2 }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

<style>
  .kmeconsulting-hero {
    padding: 0 !important;
    width: 100%;
    /* The box carries the photo's own aspect ratio (2.8:1), so on a normal
       desktop there is nothing to crop and the composition arrives intact.
       min-height is only a floor for narrow windows; below it the ratio no
       longer matches and the image starts cropping sideways — hence the
       `right` object-position: the products stay whole and what gets
       sacrificed is the empty wall on the left, the part we can spare. */
    aspect-ratio: 2.8 / 1;
    min-height: 440px;
    position: relative;
    overflow: hidden;
  }

  .kmeconsulting-hero__picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .kmeconsulting-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: right bottom;
    display: block;
  }

  .kmeconsulting-hero__inner {
    position: relative;
    width: 100%;
    height: 100%;
    padding: 80px 0;
    display: flex;
    align-items: center;
    padding-left: 10%;
    min-height: 440px;
  }

  .kmeconsulting-hero__content {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 560px;
  }

  .kmeconsulting-hero__title {
    margin: 0;
    color: var(--color-foreground);
  }

  .kmeconsulting-hero__subtitle {
    margin: 0;
    opacity: 0.7;
    color: var(--color-foreground);
    font-size: 1.2rem;
  }

  .kmeconsulting-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }

  /* Mobile is a different composition, not a squeezed one: the 2:3 shot puts
     the tins along the bottom, so the text moves to the TOP of the box rather
     than staying vertically centred over them. Breakpoint matches the
     <source media> above — they have to agree or the layout and the image
     disagree about which composition is on screen. */
  @media screen and (max-width: 749px) {
    .kmeconsulting-hero {
      aspect-ratio: 3 / 4;
      min-height: 420px;
    }

    .kmeconsulting-hero__img {
      object-position: center bottom;
    }

    .kmeconsulting-hero__inner {
      padding: 32px 20px 40px;
      align-items: flex-start;
      min-height: 420px;
    }

    .kmeconsulting-hero__content {
      max-width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "KME Hero",
  "class": "kmeconsulting-hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Professionel maling. Korrekt resultat."
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Udviklet af fagfolk - til både private, professionelle og arkitekter."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label_1",
      "label": "Button 1 label",
      "default": "Se farver"
    },
    {
      "type": "url",
      "id": "button_link_1",
      "label": "Button 1 link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Button 2 label",
      "default": "Beregn korrekt mængde"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Button 2 link"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Width",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Full" }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "KME Hero"
    }
  ]
}
{% endschema %}
