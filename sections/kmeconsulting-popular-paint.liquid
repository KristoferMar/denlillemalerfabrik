{%- comment -%}
  Populær maling — a one-row quick-add strip of the paint line.

  Each block pins ONE variant (colour + size) so the add button can post
  straight to /cart/add.js.

  Why the variant id is a setting rather than looked up in Liquid: these
  products carry 868 variants and `all_products[handle].variants` is
  hard-capped at 250 from a section (see the note in
  sections/kmeconsulting-product-finder.liquid). Råhvid is the LAST of the
  217 colours, so its variants sit far outside that window and a Liquid
  lookup would silently find nothing.

  Image IS read from the capped list, by matching the size only — every colour
  of a given size shares one bucket photo, so whichever colour turns up first
  is representative.

  Price is NOT safe to read that way any more: since 2026-09-02 Råhvid is
  priced below the tinted colours (Lys Råhvid vs. Base C on the prisliste), and
  the first variant in the capped list is always a tinted one. Each block
  therefore pins the price in `price_kr`; the size-match price is only a
  fallback when that field is empty.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading

  # Kampagne: vises kun når den er slået til OG slutdatoen ikke er nået.
  # Slutdatoen er den første dag uden udsalg (samme dag som priserne sættes
  # tilbage), så banner, overstregede priser og Shopify-priserne følges ad.
  # Liquid-tjekket kan blive stående i Shopifys side-cache lidt efter
  # midnat, derfor skjuler et lille script det også i browseren.
  assign promo_active = false
  if section.settings.promo_enabled
    assign promo_active = true
    if section.settings.promo_end != blank
      assign today_num = 'now' | date: '%Y%m%d' | plus: 0
      assign end_num = section.settings.promo_end | date: '%Y%m%d' | plus: 0
      if end_num > 0 and today_num >= end_num
        assign promo_active = false
      endif
    endif
  endif

  # Kampagnetal til banneret: største besparelse i kr, største procent og
  # antal spande på udsalg — regnet ud fra blokkene, så banner og kort
  # aldrig siger noget forskelligt.
  assign promo_max_saving = 0
  assign promo_max_pct = 0
  assign promo_count = 0
  if promo_active
    for block in section.blocks
      if block.settings.price_kr != blank and block.settings.sale_price_kr != blank
        assign b_price = block.settings.price_kr | times: 1
        assign b_sale = block.settings.sale_price_kr | times: 1
        if b_sale < b_price
          assign b_saving = b_price | minus: b_sale
          assign b_pct = b_saving | times: 100.0 | divided_by: b_price | round
          assign promo_count = promo_count | plus: 1
          if b_saving > promo_max_saving
            assign promo_max_saving = b_saving
          endif
          if b_pct > promo_max_pct
            assign promo_max_pct = b_pct
          endif
        endif
      endif
    endfor
  endif

  # Tilbuddet i banneret: første kort med udsalgspris. Knappen lægger
  # præcis den variant i kurven, som kortet gør.
  assign feat_product = blank
  if promo_active
    for block in section.blocks
      if feat_product == blank and block.settings.product != blank and block.settings.price_kr != blank and block.settings.sale_price_kr != blank
        assign f_price = block.settings.price_kr | times: 1
        assign f_sale = block.settings.sale_price_kr | times: 1
        if f_sale < f_price
          assign feat_product = block.settings.product
          assign feat_title = block.settings.title_override | default: block.settings.product.title
          assign feat_size = block.settings.size_label | default: block.settings.size
          assign feat_colour = block.settings.colour_name
          assign feat_price = f_price | times: 100
          assign feat_sale = f_sale | times: 100
          assign feat_saving = f_price | minus: f_sale | times: 100
          assign feat_pct = f_price | minus: f_sale | times: 100.0 | divided_by: f_price | round
        endif
      endif
    endfor
  endif

  # Dage tilbage, inkl. i dag. Slutdatoen er første dag uden udsalg, så
  # på sidste udsalgsdag giver det 1. Scriptet nederst regner det samme ud
  # i browseren, fordi Shopifys side-cache kan holde tallet et døgn.
  assign promo_days_left = 0
  if promo_active and section.settings.promo_end != blank
    assign now_s = 'now' | date: '%s' | plus: 0
    assign end_s = section.settings.promo_end | date: '%s' | plus: 0
    if end_s > now_s
      assign promo_days_left = end_s | minus: now_s | plus: 86399 | divided_by: 86400
    endif
  endif
-%}

<div
  class="kme-pop section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if heading != blank or subheading != blank -%}
    <header class="kme-pop__header">
      <div>
        {%- if heading != blank -%}<h2 class="kme-pop__heading">{{ heading }}</h2>{%- endif -%}
        {%- if subheading != blank -%}<p class="kme-pop__subheading">{{ subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="kme-pop__all" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </header>
  {%- endif -%}

  {%- if promo_active -%}
    <aside
      class="kme-pop__promo"
      data-kme-pop-promo
      data-end="{{ section.settings.promo_end | escape }}"
      aria-label="{{ section.settings.promo_tag | escape }}"
    >
      <div class="kme-pop__promo-main">
        {%- if section.settings.promo_tag != blank -%}
          <span class="kme-pop__promo-tag">{{ section.settings.promo_tag }}</span>
        {%- endif -%}
        <h3 class="kme-pop__promo-headline">{{ section.settings.promo_text }}</h3>
        {%- if section.settings.promo_subtext != blank -%}
          <p class="kme-pop__promo-sub">{{ section.settings.promo_subtext }}</p>
        {%- endif -%}

        {%- if feat_product != blank -%}
          <div class="kme-pop__promo-deal">
            <p class="kme-pop__promo-deal-name">
              <a href="{{ feat_product.url }}">{{ feat_title }}</a>
              {%- if feat_size != blank %} · {{ feat_size }}{% endif -%}
              {%- if feat_colour != blank %} · {{ feat_colour }}{% endif -%}
            </p>
            <p class="kme-pop__promo-price">
              <span class="kme-pop__promo-price-now">{{ feat_sale | money }}</span>
              <s class="kme-pop__promo-price-was"><span class="visually-hidden">Før </span>{{ feat_price | money }}</s>
            </p>
            <p class="kme-pop__promo-deal-saving">Du sparer {{ feat_saving | money_without_trailing_zeros }} pr. spand ({{ feat_pct }}&nbsp;%)</p>
          </div>
        {%- endif -%}
      </div>

      <div class="kme-pop__promo-side">
        {%- if promo_max_pct > 0 -%}
          <div class="kme-pop__promo-badge" aria-label="Spar op til {{ promo_max_pct }} procent">
            <span class="kme-pop__promo-badge-label">Spar</span>
            <strong class="kme-pop__promo-badge-pct">{{ promo_max_pct }}<span>%</span></strong>
            {%- if promo_max_saving > 0 -%}
              <small class="kme-pop__promo-badge-sub">op til {{ promo_max_saving | times: 100 | money_without_trailing_zeros }}<br>pr. spand</small>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.promo_note != blank or promo_days_left > 0 -%}
          <div class="kme-pop__promo-deadline">
            {%- if promo_days_left > 0 -%}
              <span class="kme-pop__promo-days" data-kme-pop-days data-days="{{ promo_days_left }}">
                {%- if promo_days_left == 1 -%}
                  Sidste dag i dag
                {%- elsif promo_days_left <= 7 -%}
                  Kun {{ promo_days_left }} dage tilbage
                {%- else -%}
                  {{ promo_days_left }} dage tilbage
                {%- endif -%}
              </span>
            {%- endif -%}
            {%- if section.settings.promo_note != blank -%}
              <span class="kme-pop__promo-note">{{ section.settings.promo_note }}</span>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </aside>
  {%- endif -%}

  <div class="kme-pop__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign size = block.settings.size | upcase | replace: ' ', ''
        assign colour = block.settings.colour_name
        assign variant_id = block.settings.variant_id | strip

        # Reset every iteration — these are section-scoped, so a block with no
        # match would otherwise inherit the previous card's price and photo.
        assign price = blank
        assign img = blank

        if product != blank
          for v in product.variants
            assign hit = false
            for opt in v.options
              assign candidate = opt | upcase | replace: ' ', ''
              if candidate == size
                assign hit = true
              endif
            endfor
            if hit
              assign price = v.price
              if v.image != blank
                assign img = v.image
              endif
              break
            endif
          endfor
        endif

        if img == blank and product.featured_image != blank
          assign img = product.featured_image
        endif

        if block.settings.price_kr != blank
          assign price = block.settings.price_kr | times: 100
        endif

        # Udsalgspris: kun mens kampagnen er aktiv, og kun hvis den faktisk er lavere.
        assign sale_price = blank
        assign sale_pct = blank
        if promo_active and block.settings.sale_price_kr != blank and price != blank
          assign sale_cents = block.settings.sale_price_kr | times: 100
          if sale_cents < price
            assign sale_price = sale_cents
            assign sale_pct = price | minus: sale_cents | times: 100.0 | divided_by: price | round
          endif
        endif
      -%}

      {%- if product != blank -%}
        <article class="kme-pop__card" {{ block.shopify_attributes }}>
          <a class="kme-pop__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {%- if sale_pct != blank -%}<span class="kme-pop__badge">&minus;{{ sale_pct }}&nbsp;%</span>{%- endif -%}
            {%- if img != blank -%}
              {{ img | image_url: width: 480 | image_tag: loading: 'lazy', alt: product.title, class: 'kme-pop__img' }}
            {%- endif -%}
          </a>

          <div class="kme-pop__body">
            <h3 class="kme-pop__title">
              <a href="{{ product.url }}">{{ block.settings.title_override | default: product.title }}</a>
            </h3>

            <p class="kme-pop__meta">
              {{- block.settings.size_label | default: size -}}
              {%- if colour != blank %} · {{ colour }}{% endif -%}
            </p>

            <div class="kme-pop__pricing">
              <p class="kme-pop__price{% if sale_price != blank %} kme-pop__price--sale{% endif %}">
                {%- if sale_price != blank -%}
                  <span class="kme-pop__price-now">{{ sale_price | money }}</span>
                  <s class="kme-pop__price-was"><span class="visually-hidden">Før </span>{{ price | money }}</s>
                {%- elsif price != blank -%}
                  {{ price | money }}
                {%- else -%}
                  &mdash;
                {%- endif -%}
              </p>
              {%- if sale_price != blank -%}
                <p class="kme-pop__saving">Du sparer {{ price | minus: sale_price | money_without_trailing_zeros }}</p>
              {%- endif -%}
            </div>

            {%- if variant_id != blank -%}
              <button
                type="button"
                class="kme-pop__add"
                data-kme-pop-add
                data-variant-id="{{ variant_id }}"
                data-colour="{{ colour | escape }}"
              >
                <span class="kme-pop__add-label">{{ section.settings.button_label | default: 'Læg i kurv' }}</span>
              </button>
            {%- else -%}
              <a class="kme-pop__add kme-pop__add--link" href="{{ product.url }}">Vælg farve</a>
            {%- endif -%}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <p class="kme-pop__error" data-kme-pop-error hidden role="alert"></p>
</div>

<style>
  /* This strip sits directly under the hero and is where the shop actually
     sells: it carries the campaign. Price is the largest text on a card, the
     saving is spelled out in kroner, and the add button is a real button
     (44px, filled). It stays a single row so it still reads as one shelf. */
  .kme-pop__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .kme-pop__heading {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .kme-pop__subheading {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    opacity: 0.75;
  }

  .kme-pop__all {
    flex: none;
    font-size: 0.9375rem;
    font-weight: 500;
    opacity: 0.85;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kme-pop__all:hover { opacity: 1; }

  /* One row, always. Wide enough and the six cards share the width; too
     narrow and it becomes a snapping scroller rather than reflowing into a
     grid — the section is defined by being a single line. */
  .kme-pop__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  @media (max-width: 999px) {
    .kme-pop__row {
      grid-auto-columns: 200px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: 6px;
      /* Stays inside the section's own gutter. An edge-to-edge bleed needs
         the theme's real page margin; guessing it put the first card left of
         the heading, which read as a layout bug rather than a flourish. */
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    .kme-pop__card { scroll-snap-align: start; }
  }

  .kme-pop__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Kampagnebanner — a sales panel, not a footnote. Warm sand ground (the
     Colorlab tone), dark type, terracotta only on the numbers, the badge and
     the button. Left: the pitch and one concrete deal with a working add
     button. Right: the "Spar 50 %" badge and the deadline. */
  .kme-pop__promo {
    --kme-promo: #B5422E;
    --kme-promo-ink: #191919;
    --kme-promo-bg: #F2ECE1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px 32px;
    margin: 0 0 20px;
    padding: 18px 26px;
    border-radius: 12px;
    background: var(--kme-promo-bg);
    color: var(--kme-promo-ink);
    line-height: 1.3;
  }

  .kme-pop__promo-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .kme-pop__promo-tag {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 6px;
    background: var(--kme-promo);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kme-pop__promo-headline {
    margin: 2px 0 0;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .kme-pop__promo-sub {
    margin: 0;
    font-size: 1.0625rem;
    opacity: 0.8;
  }

  .kme-pop__promo-deal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
    margin-top: 6px;
  }

  .kme-pop__promo-deal-name {
    width: 100%;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .kme-pop__promo-deal-name a { color: inherit; text-decoration: none; }
  .kme-pop__promo-deal-name a:hover { text-decoration: underline; text-underline-offset: 2px; }

  .kme-pop__promo-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 0;
  }

  .kme-pop__promo-price-now {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--kme-promo);
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__promo-price-was {
    font-size: 1.125rem;
    opacity: 0.5;
  }

  .kme-pop__promo-deal-saving {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .kme-pop__promo-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .kme-pop__promo-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: var(--kme-promo);
    color: #fff;
    text-align: center;
    line-height: 1;
    box-shadow: 0 10px 24px rgb(181 66 46 / 0.28);
    transform: rotate(-6deg);
  }

  .kme-pop__promo-badge-label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .kme-pop__promo-badge-pct {
    margin: 3px 0 5px;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__promo-badge-pct span { font-size: 0.6em; }

  .kme-pop__promo-badge-sub {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0.95;
  }

  .kme-pop__promo-deadline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .kme-pop__promo-days {
    padding: 6px 12px;
    border: 1px solid rgb(25 25 25 / 0.25);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .kme-pop__promo-days.is-urgent {
    border-color: var(--kme-promo);
    background: var(--kme-promo);
    color: #fff;
  }

  .kme-pop__promo-note {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  @media (max-width: 749px) {
    .kme-pop__promo {
      grid-template-columns: 1fr;
      padding: 20px 18px;
      gap: 18px;
    }

    .kme-pop__promo-side {
      flex-direction: row;
      justify-content: space-between;
      gap: 12px;
    }

    .kme-pop__promo-badge { width: 108px; height: 108px; }
    .kme-pop__promo-badge-pct { font-size: 2.125rem; }
    .kme-pop__promo-deadline { align-items: flex-end; text-align: right; }
  }

  .kme-pop__badge {
    position: absolute;
    top: 6px;
    left: 6px;
    z-index: 1;
    padding: 4px 9px;
    border-radius: 999px;
    background: #B5422E;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__price--sale {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }

  .kme-pop__price-now { color: #B5422E; }

  .kme-pop__price-was {
    font-weight: 400;
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .kme-pop__saving {
    margin: 2px 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #B5422E;
  }

  .kme-pop--promo-ended .kme-pop__badge,
  .kme-pop--promo-ended .kme-pop__saving,
  .kme-pop--promo-ended .kme-pop__price-now { display: none; }
  .kme-pop--promo-ended .kme-pop__price-was { text-decoration: none; font-size: inherit; font-weight: inherit; opacity: 1; }

  .kme-pop__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: #fff;
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
    border-radius: 6px;
    /* Ceiling on the photo so the strip stays shallow on a wide screen,
       where 1:1 of a 230px column would otherwise be taller than the text. */
    max-height: 200px;
  }

  .kme-pop__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  .kme-pop__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 1px 0;
    flex: 1;
  }

  /* Same name style as the cards on /pages/produkter: 18px, medium weight,
     at most two lines. Pricing is pinned to the bottom of the card, so a
     two-line name never pushes the buttons out of line. */
  .kme-pop__title {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .kme-pop__title a { text-decoration: none; color: inherit; }
  .kme-pop__title a:hover { text-decoration: underline; text-underline-offset: 2px; }

  .kme-pop__meta {
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.65;
  }

  /* Bottom-aligns the buttons across the row regardless of title length. */
  .kme-pop__pricing {
    margin-top: auto;
    padding: 6px 0 10px;
  }

  .kme-pop__price {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-foreground, #191919);
    border-radius: 6px;
    background: var(--color-foreground, #191919);
    color: var(--color-background, #fff);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .kme-pop__add:hover {
    background: transparent;
    color: var(--color-foreground, #191919);
  }

  .kme-pop__add[disabled] { cursor: default; }

  .kme-pop__add.is-added {
    background: #3f6f4f;
    border-color: #3f6f4f;
    color: #fff;
  }

  .kme-pop__error {
    margin: 12px 0 0;
    font-size: 0.9375rem;
    color: #b3261e;
  }
</style>

<script>
  (function () {
    var promo = document.querySelector('[data-kme-pop-promo]');
    var end = promo && promo.getAttribute('data-end');
    if (!promo || !end) return;
    var endMs = new Date(end + 'T00:00:00').getTime();
    if (!isNaN(endMs) && Date.now() >= endMs) {
      promo.hidden = true;
      var root = promo.closest('.kme-pop');
      if (root) root.classList.add('kme-pop--promo-ended');
      return;
    }
    // Same count as the Liquid above, recomputed here because the page can
    // be served from cache for up to a day.
    var daysEl = promo.querySelector('[data-kme-pop-days]');
    if (daysEl && !isNaN(endMs)) {
      var days = Math.ceil((endMs - Date.now()) / 86400000);
      if (days < 1) days = 1;
      daysEl.textContent =
        days === 1 ? 'Sidste dag i dag' : (days <= 7 ? 'Kun ' + days + ' dage tilbage' : days + ' dage tilbage');
      daysEl.classList.toggle('is-urgent', days <= 3);
    }
  })();

  (function () {
    // Scope every listener to this section instance, so two copies of the
    // section on one page don't both react to the same click.
    var section = document.currentScript ? document.currentScript.closest('.shopify-section') : null;
    var scope = section || document;
    var errorEl = scope.querySelector('[data-kme-pop-error]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }

    function hideError() {
      if (errorEl) errorEl.hidden = true;
    }

    scope.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-kme-pop-add]');
      if (!btn || btn.disabled) return;

      var id = btn.getAttribute('data-variant-id');
      var colour = btn.getAttribute('data-colour') || '';
      var label = btn.querySelector('.kme-pop__add-label');
      var original = label ? label.textContent : '';

      btn.disabled = true;
      hideError();

      var body = { id: Number(id), quantity: 1 };
      if (colour) body.properties = { 'Farve': colour };

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      })
        .then(function (res) {
          if (!res.ok) {
            return res.json().then(function (j) {
              throw new Error(j.description || j.message || 'Kunne ikke lægges i kurven.');
            });
          }
          return res.json();
        })
        .then(function () {
          if (label) label.textContent = 'Lagt i kurv';
          btn.classList.add('is-added');

          setTimeout(function () {
            if (label) label.textContent = original;
            btn.classList.remove('is-added');
            btn.disabled = false;
          }, 2200);

          // Horizon's cart icon, cart drawer and cart-items all listen for one
          // event: 'cart:update'. /cart/add.js returns the added LINE, not the
          // cart, and cart-icon SETS the bubble from detail.data.itemCount
          // (it only adds when source is 'product-form-component') — so the
          // count has to be the cart's real total, fetched here.
          // No `sections` in the payload: cart-items then re-renders itself
          // via sectionRenderer, which is correct, just one extra request.
          return fetch('/cart.js', { headers: { Accept: 'application/json' } })
            .then(function (res) { return res.json(); })
            .then(function (cart) {
              document.dispatchEvent(
                new CustomEvent('cart:update', {
                  bubbles: true,
                  detail: {
                    resource: cart,
                    sourceId: 'kme-popular-paint',
                    data: { source: 'kme-popular-paint', itemCount: cart.item_count },
                  },
                })
              );
            })
            .catch(function () {
              /* The item is in the cart either way; a stale bubble is not
                 worth surfacing an error the shopper can't act on. */
            });
        })
        .catch(function (err) {
          btn.disabled = false;
          showError(err.message || 'Noget gik galt — prøv igen.');
        });
    });
  })();
</script>

