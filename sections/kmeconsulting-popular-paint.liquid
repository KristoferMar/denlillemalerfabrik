{%- comment -%}
  Populær maling — a one-row quick-add strip of the paint line.

  Each block pins ONE variant (colour + size) so the add button can post
  straight to /cart/add.js.

  Why the variant id is a setting rather than looked up in Liquid: these
  products carry 868 variants and `all_products[handle].variants` is
  hard-capped at 250 from a section (see the note in
  sections/kmeconsulting-product-finder.liquid). Råhvid is the LAST of the
  217 colours, so its variants sit far outside that window and a Liquid
  lookup would silently find nothing.

  Image IS read from the capped list, by matching the size only — every colour
  of a given size shares one bucket photo, so whichever colour turns up first
  is representative.

  Price is NOT safe to read that way any more: since 2026-09-02 Råhvid is
  priced below the tinted colours (Lys Råhvid vs. Base C on the prisliste), and
  the first variant in the capped list is always a tinted one. Each block
  therefore pins the price in `price_kr`; the size-match price is only a
  fallback when that field is empty.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading

-%}

<div
  class="kme-pop section section--{{ section.settings.section_width }} color-{{ section.settings.color_scheme }} spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  {%- if heading != blank or subheading != blank -%}
    <header class="kme-pop__header">
      <div>
        {%- if heading != blank -%}<h2 class="kme-pop__heading">{{ heading }}</h2>{%- endif -%}
        {%- if subheading != blank -%}<p class="kme-pop__subheading">{{ subheading }}</p>{%- endif -%}
      </div>
      {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
        <a class="kme-pop__all" href="{{ section.settings.link_url }}">{{ section.settings.link_label }}</a>
      {%- endif -%}
    </header>
  {%- endif -%}

  <aside class="kme-pop__factory-banner" aria-label="Maling direkte fra fabrikken">
    <div class="kme-pop__factory-message">
      <svg class="kme-pop__factory-icon" viewBox="0 0 32 32" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round">
        <path d="M3 28V15l9-5v8l9-5v15H3ZM23 28V5h5v23M7 22h2m6 0h2m-10 4h2m6 0h2M23 9h5" />
      </svg>
      <h3 class="kme-pop__factory-title">Direkte fra fabrikken. <em>Uden mellemled.</em></h3>
    </div>
    <strong class="kme-pop__factory-offer">Fast fabrikspris</strong>
  </aside>

  <div class="kme-pop__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign product = block.settings.product
        assign size = block.settings.size | upcase | replace: ' ', ''
        assign colour = block.settings.colour_name
        assign variant_id = block.settings.variant_id | strip

        # Reset every iteration — these are section-scoped, so a block with no
        # match would otherwise inherit the previous card's price and photo.
        assign price = blank
        assign img = blank

        if product != blank
          for v in product.variants
            assign hit = false
            for opt in v.options
              assign candidate = opt | upcase | replace: ' ', ''
              if candidate == size
                assign hit = true
              endif
            endfor
            if hit
              assign price = v.price
              if v.image != blank
                assign img = v.image
              endif
              break
            endif
          endfor
        endif

        if img == blank and product.featured_image != blank
          assign img = product.featured_image
        endif

        if block.settings.price_kr != blank
          assign price = block.settings.price_kr | times: 100
        endif

      -%}

      {%- if product != blank -%}
        <article class="kme-pop__card" {{ block.shopify_attributes }}>
          <a class="kme-pop__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {%- if img != blank -%}
              {{ img | image_url: width: 480 | image_tag: loading: 'lazy', alt: product.title, class: 'kme-pop__img' }}
            {%- endif -%}
          </a>

          <div class="kme-pop__body">
            <h3 class="kme-pop__title">
              <a href="{{ product.url }}">{{ block.settings.title_override | default: product.title }}</a>
            </h3>

            <p class="kme-pop__meta">
              {{- block.settings.size_label | default: size -}}
              {%- if colour != blank %} · {{ colour }}{% endif -%}
            </p>

            <div class="kme-pop__pricing">
              <p class="kme-pop__saving">Fast fabrikspris</p>
              <p class="kme-pop__price kme-pop__factory-price">
                {%- if price != blank -%}
                  {{ price | money }}
                {%- else -%}
                  &mdash;
                {%- endif -%}
              </p>
            </div>

            {%- if variant_id != blank -%}
              <button
                type="button"
                class="kme-pop__add"
                data-kme-pop-add
                data-variant-id="{{ variant_id }}"
                data-colour="{{ colour | escape }}"
              >
                <span class="kme-pop__add-label">{{ section.settings.button_label | default: 'Læg i kurv' }}</span>
              </button>
            {%- else -%}
              <a class="kme-pop__add kme-pop__add--link" href="{{ product.url }}">Vælg farve</a>
            {%- endif -%}
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <p class="kme-pop__error" data-kme-pop-error hidden role="alert"></p>
</div>

<style>
  /* This strip sits directly under the hero and is where the shop actually
     sells: it carries the campaign. Price is the largest text on a card, the
     saving is spelled out in kroner, and the add button is a real button
     (44px, filled). It stays a single row so it still reads as one shelf. */
  .kme-pop__factory-banner {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 20px;
    overflow: hidden;
    margin-bottom: 18px;
    padding: 14px 22px;
    border: 1px solid #dfd4c2;
    border-left: 5px solid #a43b28;
    border-radius: 8px;
    background: #f2ece1;
    color: #191919;
  }
  .kme-pop__factory-banner::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 0 0 auto;
    width: 35%;
    background: repeating-linear-gradient(-55deg, transparent 0 12px, rgb(164 59 40 / 0.06) 12px 14px);
    pointer-events: none;
  }
  .kme-pop__factory-price { color: #a43b28; }
  .kme-pop__factory-message { display: flex; align-items: center; gap: 13px; }
  .kme-pop__factory-icon { width: 30px; height: 30px; flex: none; color: #a43b28; }
  .kme-pop__factory-title {
    margin: 0;
    font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .kme-pop__factory-title em {
    color: #a43b28;
    font-style: normal;
    font-weight: 500;
  }
  .kme-pop__factory-offer {
    flex-shrink: 0;
    padding: 9px 14px;
    border-radius: 3px;
    background: #a43b28;
    color: #fff;
    font-family: var(--font-heading--family, sans-serif);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.025em;
    white-space: nowrap;
    transform: rotate(-3deg);
    box-shadow: 3px 3px 0 #d9c8af;
  }
  @media (max-width: 449px) {
    .kme-pop__factory-banner { padding: 12px; gap: 10px; }
    .kme-pop__factory-price { color: #a43b28; }
  .kme-pop__factory-message { gap: 8px; }
    .kme-pop__factory-icon { width: 24px; height: 24px; }
    .kme-pop__factory-offer { padding: 8px 9px; }
  }

  .kme-pop__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 14px;
  }

  .kme-pop__heading {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .kme-pop__subheading {
    margin: 4px 0 0;
    font-size: 0.9375rem;
    line-height: 1.4;
    opacity: 0.75;
  }

  .kme-pop__all {
    flex: none;
    font-size: 0.9375rem;
    font-weight: 500;
    opacity: 0.85;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .kme-pop__all:hover { opacity: 1; }

  /* One row, always. Wide enough and the six cards share the width; too
     narrow and it becomes a snapping scroller rather than reflowing into a
     grid — the section is defined by being a single line. */
  .kme-pop__row {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: stretch;
  }

  @media (max-width: 999px) {
    .kme-pop__row {
      grid-auto-columns: 200px;
      overflow-x: auto;
      scroll-snap-type: x proximity;
      padding-bottom: 6px;
      /* Stays inside the section's own gutter. An edge-to-edge bleed needs
         the theme's real page margin; guessing it put the first card left of
         the heading, which read as a layout bug rather than a flourish. */
      -webkit-overflow-scrolling: touch;
      scrollbar-width: thin;
    }

    .kme-pop__card { scroll-snap-align: start; }
  }

  .kme-pop__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  /* Kampagnebanner — a sales panel, not a footnote. Warm sand ground (the
     Colorlab tone), dark type, terracotta only on the numbers, the badge and
     the button. Left: the pitch and one concrete deal with a working add
     button. Right: the "Spar 50 %" badge and the deadline. */
  .kme-pop__promo {
    --kme-promo: #B5422E;
    --kme-promo-ink: #191919;
    --kme-promo-bg: #F2ECE1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 16px 32px;
    margin: 0 0 20px;
    padding: 18px 26px;
    border-radius: 12px;
    background: var(--kme-promo-bg);
    color: var(--kme-promo-ink);
    line-height: 1.3;
  }

  .kme-pop__promo-main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .kme-pop__promo-tag {
    align-self: flex-start;
    padding: 5px 12px;
    border-radius: 6px;
    background: var(--kme-promo);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .kme-pop__promo-headline {
    margin: 2px 0 0;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .kme-pop__promo-sub {
    margin: 0;
    font-size: 1.0625rem;
    opacity: 0.8;
  }

  .kme-pop__promo-deal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 14px;
    margin-top: 6px;
  }

  .kme-pop__promo-deal-name {
    width: 100%;
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .kme-pop__promo-deal-name a { color: inherit; text-decoration: none; }
  .kme-pop__promo-deal-name a:hover { text-decoration: underline; text-underline-offset: 2px; }

  .kme-pop__promo-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
    margin: 0;
  }

  .kme-pop__promo-price-now {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--kme-promo);
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__promo-price-was {
    font-size: 1.125rem;
    opacity: 0.5;
  }

  .kme-pop__promo-deal-saving {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .kme-pop__promo-side {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .kme-pop__promo-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 132px;
    height: 132px;
    border-radius: 50%;
    background: var(--kme-promo);
    color: #fff;
    text-align: center;
    line-height: 1;
    box-shadow: 0 10px 24px rgb(181 66 46 / 0.28);
    transform: rotate(-6deg);
  }

  .kme-pop__promo-badge-label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .kme-pop__promo-badge-pct {
    margin: 3px 0 5px;
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__promo-badge-pct span { font-size: 0.6em; }

  .kme-pop__promo-badge-sub {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    opacity: 0.95;
  }

  .kme-pop__promo-deadline {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    text-align: center;
  }

  .kme-pop__promo-days {
    padding: 6px 12px;
    border: 1px solid rgb(25 25 25 / 0.25);
    border-radius: 999px;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .kme-pop__promo-days.is-urgent {
    border-color: var(--kme-promo);
    background: var(--kme-promo);
    color: #fff;
  }

  .kme-pop__promo-note {
    font-size: 0.875rem;
    opacity: 0.7;
  }

  @media (max-width: 749px) {
    .kme-pop__promo {
      grid-template-columns: 1fr;
      padding: 20px 18px;
      gap: 18px;
    }

    .kme-pop__promo-side {
      flex-direction: row;
      justify-content: space-between;
      gap: 12px;
    }

    .kme-pop__promo-badge { width: 108px; height: 108px; }
    .kme-pop__promo-badge-pct { font-size: 2.125rem; }
    .kme-pop__promo-deadline { align-items: flex-end; text-align: right; }
  }

  .kme-pop__badge {
    position: absolute;
    top: 6px;
    left: 6px;
    z-index: 1;
    padding: 4px 9px;
    border-radius: 999px;
    background: #B5422E;
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.5;
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__price--sale {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 8px;
  }

  .kme-pop__price-now { color: #B5422E; }

  .kme-pop__price-was {
    font-weight: 400;
    font-size: 0.875rem;
    opacity: 0.6;
  }

  .kme-pop__saving {
    margin: 2px 0 0;
    font-size: 0.8125rem;
    font-weight: 600;
    color: #B5422E;
  }

  .kme-pop--promo-ended .kme-pop__badge,
  .kme-pop--promo-ended .kme-pop__saving,
  .kme-pop--promo-ended .kme-pop__price-now { display: none; }
  .kme-pop--promo-ended .kme-pop__price-was { text-decoration: none; font-size: inherit; font-weight: inherit; opacity: 1; }

  .kme-pop__media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    background: #fff;
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
    border-radius: 6px;
    /* Ceiling on the photo so the strip stays shallow on a wide screen,
       where 1:1 of a 230px column would otherwise be taller than the text. */
    max-height: 200px;
  }

  .kme-pop__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 8px;
  }

  .kme-pop__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 10px 1px 0;
    flex: 1;
  }

  /* Same name style as the cards on /pages/produkter: 18px, medium weight,
     at most two lines. Pricing is pinned to the bottom of the card, so a
     two-line name never pushes the buttons out of line. */
  .kme-pop__title {
    margin: 0;
    font-size: 1.125rem;
    line-height: 1.25;
    font-weight: 500;
    letter-spacing: -0.01em;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .kme-pop__title a { text-decoration: none; color: inherit; }
  .kme-pop__title a:hover { text-decoration: underline; text-underline-offset: 2px; }

  .kme-pop__meta {
    margin: 0;
    font-size: 0.8125rem;
    opacity: 0.65;
  }

  /* Bottom-aligns the buttons across the row regardless of title length. */
  .kme-pop__pricing {
    margin-top: auto;
    padding: 6px 0 10px;
  }

  .kme-pop__price {
    margin: 0;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .kme-pop__add {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 44px;
    padding: 0 12px;
    border: 1px solid var(--color-foreground, #191919);
    border-radius: 6px;
    background: var(--color-foreground, #191919);
    color: var(--color-background, #fff);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
  }

  .kme-pop__add:hover {
    background: transparent;
    color: var(--color-foreground, #191919);
  }

  .kme-pop__add[disabled] { cursor: default; }

  .kme-pop__add.is-added {
    background: #3f6f4f;
    border-color: #3f6f4f;
    color: #fff;
  }

  .kme-pop__error {
    margin: 12px 0 0;
    font-size: 0.9375rem;
    color: #b3261e;
  }
</style>

<script>
  (function () {
    // Scope every listener to this section instance, so two copies of the
    // section on one page don't both react to the same click.
    var section = document.currentScript ? document.currentScript.closest('.shopify-section') : null;
    var scope = section || document;
    var errorEl = scope.querySelector('[data-kme-pop-error]');

    function showError(msg) {
      if (!errorEl) return;
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }

    function hideError() {
      if (errorEl) errorEl.hidden = true;
    }

    scope.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-kme-pop-add]');
      if (!btn || btn.disabled) return;

      var id = btn.getAttribute('data-variant-id');
      var colour = btn.getAttribute('data-colour') || '';
      var label = btn.querySelector('.kme-pop__add-label');
      var original = label ? label.textContent : '';

      btn.disabled = true;
      hideError();

      var body = { id: Number(id), quantity: 1 };
      if (colour) body.properties = { 'Farve': colour };

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(body),
      })
        .then(function (res) {
          if (!res.ok) {
            return res.json().then(function (j) {
              throw new Error(j.description || j.message || 'Kunne ikke lægges i kurven.');
            });
          }
          return res.json();
        })
        .then(function () {
          if (label) label.textContent = 'Lagt i kurv';
          btn.classList.add('is-added');

          setTimeout(function () {
            if (label) label.textContent = original;
            btn.classList.remove('is-added');
            btn.disabled = false;
          }, 2200);

          // Horizon's cart icon, cart drawer and cart-items all listen for one
          // event: 'cart:update'. /cart/add.js returns the added LINE, not the
          // cart, and cart-icon SETS the bubble from detail.data.itemCount
          // (it only adds when source is 'product-form-component') — so the
          // count has to be the cart's real total, fetched here.
          // No `sections` in the payload: cart-items then re-renders itself
          // via sectionRenderer, which is correct, just one extra request.
          return fetch('/cart.js', { headers: { Accept: 'application/json' } })
            .then(function (res) { return res.json(); })
            .then(function (cart) {
              document.dispatchEvent(
                new CustomEvent('cart:update', {
                  bubbles: true,
                  detail: {
                    resource: cart,
                    sourceId: 'kme-popular-paint',
                    data: { source: 'kme-popular-paint', itemCount: cart.item_count },
                  },
                })
              );
            })
            .catch(function () {
              /* The item is in the cart either way; a stale bubble is not
                 worth surfacing an error the shopper can't act on. */
            });
        })
        .catch(function (err) {
          btn.disabled = false;
          showError(err.message || 'Noget gik galt — prøv igen.');
        });
    });
  })();
</script>

{% schema %}
{
  "name": "KME Populær maling",
  "class": "section-wrapper",
  "settings": [
    { "type": "header", "content": "Indhold" },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Populær maling"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underoverskrift",
      "default": "Vores mest solgte i råhvid, klar til afhentning."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Knaptekst",
      "default": "Læg i kurv"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link-tekst (valgfri)",
      "default": "Se alle produkter"
    },
    { "type": "url", "id": "link_url", "label": "Link" },
    { "type": "header", "content": "Kampagnebanner" },
    {
      "type": "checkbox",
      "id": "promo_enabled",
      "label": "Vis kampagnebanner",
      "default": false
    },
    {
      "type": "text",
      "id": "promo_tag",
      "label": "Mærkat",
      "default": "Tidsbegrænset udsalg"
    },
    {
