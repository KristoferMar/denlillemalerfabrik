{%- liquid
  assign columns = section.settings.columns
  assign mobile_columns = section.settings.mobile_columns
  assign group_by_tag = section.settings.group_by_tag
  assign show_price_range = section.settings.show_price_range
-%}

<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="
    section
    section--{{ section.settings.section_width }}
    color-{{ section.settings.color_scheme }}
    spacing-style
    gap-style
  "
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% render 'gap-style', value: section.settings.gap %}
  "
>
  {%- if section.settings.heading != blank -%}
    <h2 class="kmeconsulting-produkter__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.description != blank -%}
    <p class="kmeconsulting-produkter__description">{{ section.settings.description }}</p>
  {%- endif -%}

  {%- comment -%} Paginate to access all products (Shopify limits to 50 without pagination) {%- endcomment -%}
  {%- paginate collections['all'].products by 250 -%}
  {%- assign all_products = collections['all'].products -%}

  {%- if group_by_tag -%}
    {%- comment -%} Maling first: every product tagged "paint" (except Specialblanding), ordered by paint type, then glans {%- endcomment -%}
    {%- assign paint_type_order = 'vaegmaling,loftmaling,strukturmaling,gulvmaling' | split: ',' -%}
    {%- comment -%} trae-og-metal and traebeskyttelse live in the "Træ & metal" category below (tag: trae-metal) {%- endcomment -%}
    {%- comment -%} "none" is the last slot per paint type: products with no glans:* tag (e.g. Træbeskyttelse Vandbaseret) {%- endcomment -%}
    {%- assign glans_order = '1,5,10,20,25,40,60,none' | split: ',' -%}
    {%- assign has_paint = false -%}
    {%- for product in all_products -%}
      {%- if product.tags contains 'paint' and product.tags contains 'specialblanding' -%}
        {%- continue -%}
      {%- endif -%}
      {%- if product.tags contains 'paint' -%}
        {%- assign has_paint = true -%}
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if has_paint -%}
      <div class="kmeconsulting-produkter__category" id="kategori-maling">
        <h3 class="kmeconsulting-produkter__category-title">Maling</h3>
        <div
          class="kmeconsulting-produkter__grid"
          style="
            --columns: {{ columns }};
            --mobile-columns: {{ mobile_columns }};
          "
        >
          {%- for paint_type in paint_type_order -%}
            {%- assign type_tag = 'paint-type:' | append: paint_type -%}
            {%- for glans in glans_order -%}
              {%- assign glans_tag = 'glans:' | append: glans -%}
              {%- for product in all_products -%}
                {%- if product.tags contains 'specialblanding' -%}
                  {%- continue -%}
                {%- endif -%}
                {%- assign glans_match = false -%}
                {%- if glans == 'none' -%}
                  {%- assign tag_str = product.tags | join: ',' | prepend: ',' -%}
                  {%- unless tag_str contains ',glans:' -%}
                    {%- assign glans_match = true -%}
                  {%- endunless -%}
                {%- elsif product.tags contains glans_tag -%}
                  {%- assign glans_match = true -%}
                {%- endif -%}
                {%- if product.tags contains type_tag and glans_match -%}
                  <a href="{{ product.url }}" class="kmeconsulting-produkter__card">
                    <div class="kmeconsulting-produkter__card-image">
                      {%- if product.featured_image -%}
                        <img
                          src="{{ product.featured_image | image_url: width: 600 }}"
                          alt="{{ product.title | escape }}"
                          width="300"
                          height="300"
                          loading="lazy"
                        >
                      {%- else -%}
                        <div class="kmeconsulting-produkter__card-placeholder">
                          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {%- endif -%}
                    </div>
                    <div class="kmeconsulting-produkter__card-info">
                      <h4 class="kmeconsulting-produkter__card-title">{{ product.title }}</h4>
                      {%- if show_price_range -%}
                        <span class="kmeconsulting-produkter__card-price">
                          {%- if product.price_varies -%}
                            <span class="kmeconsulting-produkter__card-from">Fra</span> {{ product.price_min | money }}
                          {%- else -%}
                            {{ product.price | money }}
                          {%- endif -%}
                        </span>
                      {%- endif -%}
                      <span class="kmeconsulting-produkter__card-variants">
                        {%- if product.options contains 'Farve' -%}
                          Alle farver · flere størrelser
                        {%- else -%}
                          Utonet · flere størrelser
                        {%- endif -%}
                      </span>
                    </div>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            {%- endfor -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      Special coatings outside the paint line, one category per tag. "Title|tag" — the tag doubles as the anchor slug (#kategori-tag).
      whiteboardmaling: AquaWrite (import-writewall-aquawrite.js) · lak-industri: LF lacquers and 2K coatings (import-larsfrey-lak.js)
      mur-facade-tag: roof/facade/plinth paints · trae-metal: wood & metal products without the colour configurator
      rens-forbehandling: cleaners and primers made by DLM (Husrens, Universalrens, Microdispers, grundingsolier)
      Split on ";" because a title may contain a comma ("Mur, facade & tag").
    {%- endcomment -%}
    {%- assign special_categories = 'Træ & metal|trae-metal;Mur, facade & tag|mur-facade-tag;Rens & forbehandling|rens-forbehandling;Whiteboardmaling|whiteboardmaling;Lak & industri|lak-industri' | split: ';' -%}

    {%- for special_pair in special_categories -%}
      {%- assign special_parts = special_pair | split: '|' -%}
      {%- assign special_title = special_parts[0] -%}
      {%- assign special_tag = special_parts[1] -%}
      {%- assign has_special = false -%}
      {%- for product in all_products -%}
        {%- if product.tags contains special_tag -%}
          {%- assign has_special = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_special -%}
      <div class="kmeconsulting-produkter__category" id="kategori-{{ special_tag }}">
        <h3 class="kmeconsulting-produkter__category-title">{{ special_title }}</h3>
        <div
          class="kmeconsulting-produkter__grid"
          style="
            --columns: {{ columns }};
            --mobile-columns: {{ mobile_columns }};
          "
        >
          {%- for product in all_products -%}
            {%- if product.tags contains special_tag -%}
              <a href="{{ product.url }}" class="kmeconsulting-produkter__card">
                <div class="kmeconsulting-produkter__card-image">
                  {%- if product.featured_image -%}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.title | escape }}"
                      width="300"
                      height="300"
                      loading="lazy"
                    >
                  {%- else -%}
                    <div class="kmeconsulting-produkter__card-placeholder">
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
                </div>
                <div class="kmeconsulting-produkter__card-info">
                  <h4 class="kmeconsulting-produkter__card-title">{{ product.title }}</h4>
                  {%- if show_price_range -%}
                    <span class="kmeconsulting-produkter__card-price">
                      {%- if product.price_varies -%}
                        <span class="kmeconsulting-produkter__card-from">Fra</span> {{ product.price_min | money }}
                      {%- else -%}
                        {{ product.price | money }}
                      {%- endif -%}
                    </span>
                  {%- endif -%}
                  <span class="kmeconsulting-produkter__card-variants">
                    {%- if product.options contains 'Farve' -%}
                      Alle farver · flere størrelser
                    {%- elsif product.tags contains 'paint' -%}
                      Utonet · flere størrelser
                    {%- else -%}
                      {{ product.variants.size }} {% if product.variants.size == 1 %}variant{% else %}varianter{% endif %}
                    {%- endif -%}
                  </span>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
      {%- endif -%}
    {%- endfor -%}

    {%- comment -%} "Tag|slug" — the slug is the stable anchor id (#kategori-slug) used by the header menu; handleize would mangle æ/ø/å {%- endcomment -%}
    {%- assign tag_order = 'Pensler|pensler,Ruller|ruller,Sandpapir|sandpapir,Tape|tape,Afdækning|afdaekning,Spartler|spartler,Anstrygere|anstrygere,Rullehåndtag|rullehaandtag,Malerbakker|malerbakker,Handsker|handsker,Kunstpensler|kunstpensler,Tilbehør|tilbehoer,Diverse|diverse' | split: ',' -%}

    {%- for tag_pair in tag_order -%}
      {%- assign tag_parts = tag_pair | split: '|' -%}
      {%- assign tag = tag_parts[0] -%}
      {%- assign tag_slug = tag_parts[1] -%}
      {%- assign has_products = false -%}
      {%- for product in all_products -%}
        {%- if product.tags contains 'Lars Frey' and product.tags contains tag -%}
          {%- assign has_products = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_products -%}
        <div class="kmeconsulting-produkter__category" id="kategori-{{ tag_slug }}">
          <h3 class="kmeconsulting-produkter__category-title">{{ tag }}</h3>
          <div
            class="kmeconsulting-produkter__grid"
            style="
              --columns: {{ columns }};
              --mobile-columns: {{ mobile_columns }};
            "
          >
            {%- for product in all_products -%}
              {%- if product.tags contains 'Lars Frey' and product.tags contains tag -%}
                <a href="{{ product.url }}" class="kmeconsulting-produkter__card">
                  <div class="kmeconsulting-produkter__card-image">
                    {%- if product.featured_image -%}
                      <img
                        src="{{ product.featured_image | image_url: width: 600 }}"
                        alt="{{ product.title | escape }}"
                        width="300"
                        height="300"
                        loading="lazy"
                      >
                    {%- else -%}
                      <div class="kmeconsulting-produkter__card-placeholder">
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="kmeconsulting-produkter__card-info">
                    <h4 class="kmeconsulting-produkter__card-title">{{ product.title }}</h4>
                    {%- if show_price_range -%}
                      <span class="kmeconsulting-produkter__card-price">
                        {%- if product.price_varies -%}
                          <span class="kmeconsulting-produkter__card-from">Fra</span> {{ product.price_min | money }}
                        {%- else -%}
                          {{ product.price | money }}
                        {%- endif -%}
                      </span>
                    {%- endif -%}
                    <span class="kmeconsulting-produkter__card-variants">
                      {{ product.variants.size }} varianter
                    </span>
                  </div>
                </a>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    <div
      class="kmeconsulting-produkter__grid"
      style="
        --columns: {{ columns }};
        --mobile-columns: {{ mobile_columns }};
      "
    >
      {%- for product in all_products -%}
        {%- if product.tags contains 'Lars Frey' -%}
          <a href="{{ product.url }}" class="kmeconsulting-produkter__card">
            <div class="kmeconsulting-produkter__card-image">
              {%- if product.featured_image -%}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.title | escape }}"
                  width="300"
                  height="300"
                  loading="lazy"
                >
              {%- else -%}
                <div class="kmeconsulting-produkter__card-placeholder">
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {%- endif -%}
            </div>
            <div class="kmeconsulting-produkter__card-info">
              <h4 class="kmeconsulting-produkter__card-title">{{ product.title }}</h4>
              {%- if show_price_range -%}
                <span class="kmeconsulting-produkter__card-price">
                  {%- if product.price_varies -%}
                    <span class="kmeconsulting-produkter__card-from">Fra</span> {{ product.price_min | money }}
                  {%- else -%}
                    {{ product.price | money }}
                  {%- endif -%}
                </span>
              {%- endif -%}
              <span class="kmeconsulting-produkter__card-variants">
                {{ product.variants.size }} varianter
              </span>
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- comment -%} Category quick-nav (sticky on desktop) {%- endcomment -%}
  {%- if group_by_tag and section.settings.show_category_nav -%}
    <nav class="kmeconsulting-produkter__nav" aria-label="Produktkategorier">
      {%- if has_paint -%}
        <a href="#kategori-maling" class="kmeconsulting-produkter__nav-link">Maling</a>
      {%- endif -%}
      {%- for special_pair in special_categories -%}
        {%- assign special_parts = special_pair | split: '|' -%}
        {%- assign has_special = false -%}
        {%- for product in all_products -%}
          {%- if product.tags contains special_parts[1] -%}
            {%- assign has_special = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_special -%}
          <a href="#kategori-{{ special_parts[1] }}" class="kmeconsulting-produkter__nav-link">{{ special_parts[0] }}</a>
        {%- endif -%}
      {%- endfor -%}
      {%- for tag_pair in tag_order -%}
        {%- assign tag_parts = tag_pair | split: '|' -%}
        {%- assign tag = tag_parts[0] -%}
        {%- assign tag_slug = tag_parts[1] -%}
        {%- assign has_products = false -%}
        {%- for product in all_products -%}
          {%- if product.tags contains 'Lars Frey' and product.tags contains tag -%}
            {%- assign has_products = true -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        {%- if has_products -%}
          <a href="#kategori-{{ tag_slug }}" class="kmeconsulting-produkter__nav-link">{{ tag }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>
  {%- endif -%}
  {%- endpaginate -%}
</div>

<style>
  .kmeconsulting-produkter__heading {
    text-align: center;
    margin: 0;
  }

  .kmeconsulting-produkter__description {
    text-align: center;
    margin: 0;
    opacity: 0.7;
    max-width: 600px;
    align-self: center;
  }

  /* ── Category groups ── */
  .kmeconsulting-produkter__category {
    width: 100%;
    scroll-margin-top: calc(var(--header-height, 60px) + 24px);
    margin-top: 48px;
  }

  .kmeconsulting-produkter__category:first-child {
    margin-top: 0;
  }

  .kmeconsulting-produkter__category-title {
    margin: 0 0 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.12);
    font-size: 1.6rem;
  }

  /* ── Product grid ── */
  .kmeconsulting-produkter__grid {
    display: grid;
    grid-template-columns: repeat(var(--mobile-columns, 2), 1fr);
    gap: 16px;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .kmeconsulting-produkter__grid {
      grid-template-columns: repeat(var(--columns, 4), 1fr);
      gap: 24px;
    }
  }

  /* ── Product card ── */
  .kmeconsulting-produkter__card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
    overflow: hidden;
    background: rgb(var(--color-foreground-rgb, 0 0 0) / 0.03);
    transition:
      transform var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out),
      box-shadow var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out);
  }

  .kmeconsulting-produkter__card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgb(var(--color-foreground-rgb, 0 0 0) / 0.1);
  }

  /* ── Card image ── */
  .kmeconsulting-produkter__card-image {
    /* Fixed frame so portrait and landscape bucket shots give equal card heights.
       6:5 matches most production renders (~1370×1148); others are contained inside. */
    aspect-ratio: 6 / 5;
    overflow: hidden;
    background: #fff;
  }

  .kmeconsulting-produkter__card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform var(--hover-transition-duration, 0.25s) var(--hover-transition-timing, ease-out);
  }

  .kmeconsulting-produkter__card:hover .kmeconsulting-produkter__card-image img {
    transform: scale(1.05);
  }

  .kmeconsulting-produkter__card-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    opacity: 0.3;
  }

  .kmeconsulting-produkter__card-placeholder svg {
    width: 100%;
    height: 100%;
  }

  /* ── Card info ── */
  .kmeconsulting-produkter__card-info {
    padding: 12px 16px 16px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  /* Same hierarchy as the "Populær maling" cards on the front page:
     name (medium) → meta line (small, muted) → price (largest, bold).
     The meta line sits between name and price on purpose — two bold black
     lines directly on top of each other read as one lump. Order is set here
     rather than in the markup so all card variants on the page follow it. */
  .kmeconsulting-produkter__card-title {
    order: 1;
    margin: 0;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    /* At most two lines; anything past that is cut with an ellipsis. On the
       desktop grid (~244px of text) 18px fits ~27 characters per line; only
       one name in the catalogue is long enough to hit the ellipsis. No
       reserved height — a one-line name sits tight against the meta line
       rather than leaving an empty line under it. */
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    overflow-wrap: anywhere;
  }

  .kmeconsulting-produkter__card-variants {
    order: 2;
    font-size: 0.8125rem;
    opacity: 0.65;
  }

  .kmeconsulting-produkter__card-price {
    order: 3;
    margin-top: 2px;
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground, inherit);
  }

  .kmeconsulting-produkter__card-from {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0;
    opacity: 0.6;
  }

  /* ── Category nav ── */
  .kmeconsulting-produkter__nav {
    position: fixed;
    top: calc(var(--header-height, 60px) + 24px);
    right: 24px;
    display: none;
    flex-direction: column;
    gap: 6px;
    background: var(--color-background, #fff);
    border: 1px solid rgb(var(--color-foreground-rgb, 0 0 0) / 0.1);
    border-radius: 8px;
    padding: 12px 16px;
    max-height: calc(100vh - var(--header-height, 60px) - 80px);
    overflow-y: auto;
    z-index: 10;
    box-shadow: 0 2px 12px rgb(var(--color-foreground-rgb, 0 0 0) / 0.08);
  }

  @media screen and (min-width: 1200px) {
    .kmeconsulting-produkter__nav {
      display: flex;
    }
  }

  .kmeconsulting-produkter__nav-link {
    font-size: 0.75rem;
    text-decoration: none;
    color: inherit;
    opacity: 0.6;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .kmeconsulting-produkter__nav-link:hover {
    opacity: 1;
  }


</style>

{% schema %}
{
  "name": "Produktkatalog",
  "class": "kmeconsulting-produkter",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Vores produkter"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beskrivelse",
      "default": "Professionelt malerværktøj fra Lars Frey Farve og Lak"
    },
    {
      "type": "checkbox",
      "id": "group_by_tag",
      "label": "Grupper efter kategori",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_price_range",
      "label": "Vis prisområde",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_category_nav",
      "label": "Vis kategori-navigation (desktop)",
      "default": true,
      "info": "Fast navigation i højre side på store skærme"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Kolonner (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Kolonner (mobil)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Sektionslayout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Bredde",
      "options": [
        { "value": "page-width", "label": "Sidebredde" },
        { "value": "full-width", "label": "Fuld bredde" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Mellemrum",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farveskema",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bund",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
